            lines {
              text: "export function renderMapTravel(ctx: CanvasRenderingContext2D, tr: TravelState, bgTime: number): void {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const fromLvl = LEVELS[tr.fromIndex];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const toLvl = LEVELS[tr.toIndex];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const rawT = Math.max(0, Math.min(1, tr.progress));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const t = rawT < 0.5 ? 2 * rawT * rawT : 1 - Math.pow(-2 * rawT + 2, 2) / 2;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
