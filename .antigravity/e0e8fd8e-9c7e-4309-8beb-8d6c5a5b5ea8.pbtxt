              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ctx.ellipse(0, -pl.h * 0.52 - celebrateHop, 31 * pulse, 37 * pulse, 0, 0, Math.PI * 2);"
