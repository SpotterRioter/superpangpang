              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (!tr.isSpace) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const bg = ctx.createRadialGradient(WORLD_W * 0.5, WORLD_H * 0.45, 60, WORLD_W * 0.5, WORLD_H * 0.5, WORLD_W * 0.65);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    bg.addColorStop(0, \'#0f3460\');"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    bg.addColorStop(0.6, \'#08203e\');"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
