            }
            lines {
              text: "    if (this.ctx.state !== \'running\') return;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const track = OST_TRACKS[this.currentTheme];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (!track) return;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const stepSec = 60 / track.bpm / 4;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (this.nextNoteTime < this.ctx.currentTime - 0.15) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
