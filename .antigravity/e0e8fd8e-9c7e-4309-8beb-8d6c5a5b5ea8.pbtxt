              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (theme === \'fuji\' || theme === \'delhi\' || theme === \'beijing\' || theme === \'buenosaires\') {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    for (const p of PETALS) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
