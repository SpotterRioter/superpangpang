            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  private scheduleStep(track: OstTrackDef, step: number, time: number, stepSec: number): void {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (!this.ctx || !this.musicBus) return;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
