      arguments_json: "{\"CodeContent\":\"@import \\\"tailwindcss\\\";\\n\\n@layer base {\\n  * {\\n    box-sizing: border-box;\\n    -webkit-tap-highlight-color: transparent;\\n    -webkit-touch-callout: none;\\n  }\\n\\n  html,\\n  body,\\n  #root {\\n    width: 100%;\\n    height: 100%;\\n    margin: 0;\\n    padding: 0;\\n    overflow: hidden;\\n    font-family: \'Chakra Petch\', system-ui, -apple-system, sans-serif;\\n    background: radial-gradient(circle at 50% 10%, #15213d 0%, #070b16 68%, #04060c 100%);\\n  }\\n}\\n\\n.font-arcade {\\n  font-family: \'Press Start 2P\', monospace;\\n}\\n\\n.font-ui {\\n  font-family: \'Chakra Petch\', system-ui, sans-serif;\\n}\\n\\n.tabular-nums {\\n  font-variant-numeric: tabular-nums;\\n}\\n\\n@keyframes modalPop {\\n  0% {\\n    opacity: 0;\\n    transform: scale(0.95) translateY(8px);\\n  }\\n  100% {\\n    opacity: 1;\\n    transform: scale(1) translateY(0);\\n  }\\n}\\n\\n.animate-modal-pop {\\n  animation: modalPop 180ms cubic-bezier(0.16, 1, 0.3, 1) forwards;\\n}\\n\\n/* Custom subtle dark scrollbar for stage grid */\\n.stage-scroll::-webkit-scrollbar {\\n  width: 6px;\\n}\\n.stage-scroll::-webkit-scrollbar-track {\\n  background: rgba(8, 12, 24, 0.6);\\n  border-radius: 999px;\\n}\\n.stage-scroll::-webkit-scrollbar-thumb {\\n  background: rgba(96, 130, 198, 0.45);\\n  border-radius: 999px;\\n}\\n.stage-scroll::-webkit-scrollbar-thumb:hover {\\n  background: rgba(56, 189, 248, 0.7);\\n}\\n\",\"Description\":\"Set up Tailwind CSS v4 styles, arcade font helpers, and modal animations\",\"Overwrite\":true,\"TargetFile\":\"/src/index.css\",\"toolAction\":\"Updating src/index.css\",\"toolSummary\":\"Update src/index.css\"}"
      original_name: "write_to_file"
    }
