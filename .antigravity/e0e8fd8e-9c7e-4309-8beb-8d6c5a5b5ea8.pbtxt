              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        wave = profile === \'ukulele\' ? \'triangle\' : \'sawtooth\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        filterStart = profile === \'ukulele\' ? 2200 : 3400;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        filterEnd = 650;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
