      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"export type GameState =\\n  | \'START\'\\n  | \'PLAYING\'\\n  | \'PAUSED\'\\n  | \'STAGE_CLEAR\'\\n  | \'MAP_TRAVEL\'\\n  | \'GAME_OVER\'\\n  | \'VICTORY\';\\n\\nexport type PowerupType =\\n  | \'double\'\\n  | \'sticky\'\\n  | \'shield\'\\n  | \'freeze\'\\n  | \'dynamite\'\\n  | \'extralife\';\\n\\nexport type ThemeId =\\n  | \'fuji\'\\n  | \'pyramids\'\\n  | \'neon\'\\n  | \'alps\'\\n  | \'caribbean\'\\n  | \'temple\'\\n  | \'rio\'\\n  | \'saopaulo\'\\n  | \'buenosaires\'\\n  | \'machupicchu\'\\n  | \'habana\'\\n  | \'vegas\'\\n  | \'nyc\'\\n  | \'madrid\'\\n  | \'london\'\\n  | \'rome\'\\n  | \'moscow\'\\n  | \'delhi\'\\n  | \'bangkok\'\\n  | \'beijing\'\\n  | \'sydney\'\\n  | \'honolulu\'\\n  | \'moon\'\\n  | \'mars\';\\n\\nexport type RegionGroup =\\n  | \'\303\201sia & Pac\303\255fico\'\\n  | \'Am\303\251ricas\'\\n  | \'Europa & \303\201frica\'\\n  | \'Espa\303\247o\';\\n\\nexport interface BubbleConfig {\\n  x: number;\\n  y: number;\\n  size: 0 | 1 | 2 | 3;\\n  dir: 1 | -1;\\n}\\n\\nexport interface BlockConfig {\\n  x: number;\\n  y: number;\\n  w: number;\\n  h: number;\\n  destructible: boolean;\\n}\\n\\nexport interface LevelDef {\\n  id: number;\\n  name: string;\\n  country: string;\\n  region: RegionGroup;\\n  flag: string;\\n  theme: ThemeId;\\n  mapX: number;\\n  mapY: number;\\n  spaceStage?: boolean;\\n  gravityScale: number;\\n  timeLimit: number;\\n  palette: [string, string, string, string];\\n  swatch: [string, string];\\n  bubbles: BubbleConfig[];\\n  blocks: BlockConfig[];\\n}\\n\\nexport interface ScarfNode {\\n  x: number;\\n  y: number;\\n}\\n\\nexport interface Player {\\n  x: number;\\n  y: number;\\n  w: number;\\n  h: number;\\n  speed: number;\\n  facing: 1 | -1;\\n  prevMoveDir: number;\\n  vx: number;\\n  tilt: number;\\n  walkCycle: number;\\n  shootAnim: number;\\n  recoil: number;\\n  muzzleFlash: number;\\n  blinkTimer: number;\\n  isBlinking: boolean;\\n  goggleGlint: number;\\n  invulnTimer: number;\\n  hasShield: boolean;\\n  doubleTimer: number;\\n  stickyTimer: number;\\n  scarfNodes: ScarfNode[];\\n}\\n\\nexport interface Bubble {\\n  x: number;\\n  y: number;\\n  size: 0 | 1 | 2 | 3;\\n  r: number;\\n  vx: number;\\n  vy: number;\\n  scaleX: number;\\n  scaleY: number;\\n  rotAngle: number;\\n  wobble: number;\\n  flashTimer: number;\\n}\\n\\nexport interface Harpoon {\\n  x: number;\\n  topY: number;\\n  bottomY: number;\\n  speed: number;\\n  sticky: boolean;\\n  latched: boolean;\\n  latchTimer: number;\\n  waveOffset: number;\\n  sparksTimer: number;\\n}\\n\\nexport interface Block {\\n  x: number;\\n  y: number;\\n  w: number;\\n  h: number;\\n  destructible: boolean;\\n}\\n\\nexport interface PowerupItem {\\n  x: number;\\n  y: number;\\n  vy: number;\\n  r: number;\\n  type: PowerupType;\\n  life: number;\\n  spin: number;\\n}\\n\\nexport interface Particle {\\n  x: number;\\n  y: number;\\n  vx: number;\\n  vy: number;\\n  r: number;\\n  color: string;\\n  life: number;\\n  maxLife: number;\\n  gravity?: number;\\n  glow?: boolean;\\n}\\n\\nexport interface Shard {\\n  x: number;\\n  y: number;\\n  vx: number;\\n  vy: number;\\n  w: number;\\n  h: number;\\n  rot: number;\\n  vrot: number;\\n  color: string;\\n  border: string;\\n  life: number;\\n  maxLife: number;\\n}\\n\\nexport interface ShockRing {\\n  x: number;\\n  y: number;\\n  r: number;\\n  maxR: number;\\n  color: string;\\n  life: number;\\n  maxLife: number;\\n}\\n\\nexport interface ScorePopup {\\n  x: number;\\n  y: number;\\n  text: string;\\n  color: string;\\n  scale?: number;\\n  life: number;\\n  maxLife: number;\\n}\\n\\nexport interface TravelState {\\n  fromIndex: number;\\n  toIndex: number;\\n  progress: number;\\n  duration: number;\\n  isSpace: boolean;\\n  exhaust: Particle[];\\n}\\n\\nexport interface HudSnapshot {\\n  state: GameState;\\n  score: number;\\n  highScore: number;\\n  newRecordReached: boolean;\\n  levelIndex: number;\\n  levelId: number;\\n  totalLevels: number;\\n  stageName: string;\\n  stageCountry: string;\\n  stageFlag: string;\\n  isSpace: boolean;\\n  ostTitle: string;\\n  lives: number;\\n  timeRemaining: number;\\n  timeLimit: number;\\n  doubleTimer: number;\\n  stickyTimer: number;\\n  hasShield: boolean;\\n  freezeTimer: number;\\n  comboCount: number;\\n  stageTimeBonus: number;\\n  victoryLivesBonus: number;\\n  gameOverReason: string;\\n  musicEnabled: boolean;\\n  sfxMuted: boolean;\\n}\\n\",\"Description\":\"Define core TypeScript interfaces and types for Super Pang World Tour\",\"Overwrite\":true,\"TargetFile\":\"/src/game/types.ts\",\"toolAction\":\"Creating src/game/types.ts\",\"toolSummary\":\"Create game types\"}"
      original_name: "write_to_file"
