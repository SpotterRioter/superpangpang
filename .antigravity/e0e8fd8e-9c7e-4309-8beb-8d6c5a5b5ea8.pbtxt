            lines {
              text: "  private playLeadInstrument(profile: InstrumentProfile, freq: number, time: number, dur: number): void {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (!this.ctx || !this.musicBus) return;"
