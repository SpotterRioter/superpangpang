            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (pl.shootAnim > 0) pl.shootAnim = Math.max(0, pl.shootAnim - dt);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (pl.recoil > 0) pl.recoil = Math.max(0, pl.recoil - dt * 6.5);"
