              text: "      ctx.fillStyle = isTarget ? \'#fde047\' : isVisited ? \'#38bdf8\' : \'rgba(255,255,255,0.35)\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      ctx.beginPath();"
