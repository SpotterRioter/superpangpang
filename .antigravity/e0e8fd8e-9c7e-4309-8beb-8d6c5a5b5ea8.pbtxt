            lines {
              text: "      ctx.beginPath();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      ctx.roundRect(mx, GROUND_Y - 75, 130, 14, 5);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      ctx.fill();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      ctx.fillStyle = \'#22d3ee\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
