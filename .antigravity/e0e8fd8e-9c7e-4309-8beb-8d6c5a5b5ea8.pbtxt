              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      pl.walkCycle = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    pl.x = Math.max(LEFT_WALL + pl.w / 2, Math.min(RIGHT_WALL - pl.w / 2, pl.x));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const targetTilt = moveDir * 0.095;"
