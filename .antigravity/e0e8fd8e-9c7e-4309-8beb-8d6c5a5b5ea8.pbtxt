              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      case \'oud\':"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      case \'sitar\':"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        wave = \'sawtooth\';"
