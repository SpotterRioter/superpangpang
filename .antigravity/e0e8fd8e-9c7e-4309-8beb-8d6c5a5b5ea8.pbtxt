              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      this.victoryLivesBonus = this.lives * 2000;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      this.addScore(this.victoryLivesBonus);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      this.audio.victory();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      this.emitHud();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      return;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    this.state = \'STAGE_CLEAR\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    this.audio.stopMusic();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    this.audio.stageClear();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    this.emitHud();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // ========================================================================="
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // COLLISIONS & SIMULATION LOOP"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // ========================================================================="
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  private resolveBubbleBlockCollision(b: Bubble, block: Block): void {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const closestX = Math.max(block.x, Math.min(b.x, block.x + block.w));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const closestY = Math.max(block.y, Math.min(b.y, block.y + block.h));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const dx = b.x - closestX;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const dy = b.y - closestY;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (dx * dx + dy * dy < b.r * b.r) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const overlapLeft = b.x + b.r - block.x;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const overlapRight = block.x + block.w - (b.x - b.r);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const overlapTop = b.y + b.r - block.y;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const overlapBottom = block.y + block.h - (b.y - b.r);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const minOverlap = Math.min(overlapLeft, overlapRight, overlapTop, overlapBottom);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (minOverlap === overlapTop) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        b.y = block.y - b.r;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        b.vy = -Math.max(Math.abs(b.vy) * 0.92, Math.abs(BUBBLE_SPECS[b.size].bounceVy) * 0.72);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        b.scaleX = 1.22;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        b.scaleY = 0.8;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      } else if (minOverlap === overlapBottom) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        b.y = block.y + block.h + b.r;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        b.vy = Math.abs(b.vy) * 0.8 + 40;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      } else if (minOverlap === overlapLeft) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        b.x = block.x - b.r;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        b.vx = -Math.abs(b.vx);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        b.scaleX = 0.84;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        b.scaleY = 1.16;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      } else {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        b.x = block.x + block.w + b.r;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        b.vx = Math.abs(b.vx);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        b.scaleX = 0.84;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        b.scaleY = 1.16;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  private circleIntersectsVerticalLine("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    cx: number,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    cy: number,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    r: number,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    lineX: number,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    topY: number,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    bottomY: number"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  ): boolean {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const clampedY = Math.max(topY, Math.min(cy, bottomY));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const dx = cx - lineX;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const dy = cy - clampedY;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    return dx * dx + dy * dy <= (r + 5) * (r + 5);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  private updateScarfPhysics(dt: number): void {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const pl = this.player;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const isMoving = Math.abs(pl.vx) > 5;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const anchorX = pl.x - pl.facing * 2;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const anchorY = pl.y - 37 - (isMoving ? Math.abs(Math.cos(pl.walkCycle)) * 2.6 : Math.sin(this.bgTime * 3.5));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    pl.scarfNodes[0].x = anchorX;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    pl.scarfNodes[0].y = anchorY;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const windX = isMoving ? -Math.sign(pl.vx) * 215 : -pl.facing * 56;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const segLen = 5.5;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    for (let i = 1; i < pl.scarfNodes.length; i++) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const prev = pl.scarfNodes[i - 1];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const curr = pl.scarfNodes[i];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const flutter = Math.sin(this.bgTime * (isMoving ? 19 : 7.5) - i * 0.9) * (isMoving ? 56 : 22);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      curr.x += windX * dt;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      curr.y += (32 + flutter) * dt;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const dx = curr.x - prev.x;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const dy = curr.y - prev.y;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const dist = Math.hypot(dx, dy) || 0.001;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      curr.x = prev.x + (dx / dist) * segLen;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      curr.y = prev.y + (dy / dist) * segLen;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  private update(dt: number): void {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    this.bgTime += dt;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // Live-world scenic tour cycling on the Title Screen!"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (this.state === \'START\') {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      this.showcaseTimer += dt;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (this.showcaseTimer >= 7.5) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        this.showcaseTimer = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        this.showcaseCursor = (this.showcaseCursor + 1) % SHOWCASE_INDICES.length;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        this.levelIndex = SHOWCASE_INDICES[this.showcaseCursor];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const lvl = LEVELS[this.levelIndex];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        this.bubbles = lvl.bubbles.map((b) => this.createBubble(b.x, b.y, b.size, b.dir, -80));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        this.blocks = lvl.blocks.map((bl) => ({ ...bl }));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        this.emitHud();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const theme = LEVELS[this.levelIndex].theme;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      updateAmbientWeather(dt, this.bgTime, theme);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      this.updateScarfPhysics(dt);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // Gently animate showcase bubbles in the background!"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const gravity = BASE_GRAVITY * (LEVELS[this.levelIndex].gravityScale || 1.0);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      for (const b of this.bubbles) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const spec = BUBBLE_SPECS[b.size];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        b.scaleX += (1 - b.scaleX) * Math.min(1, dt * 14);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        b.scaleY += (1 - b.scaleY) * Math.min(1, dt * 14);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        b.vy += gravity * dt;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        b.x += b.vx * dt;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        b.y += b.vy * dt;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        b.rotAngle += (b.vx / b.r) * dt * 0.55;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        if (b.x - b.r < LEFT_WALL) { b.x = LEFT_WALL + b.r; b.vx = Math.abs(b.vx); }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        if (b.x + b.r > RIGHT_WALL) { b.x = RIGHT_WALL - b.r; b.vx = -Math.abs(b.vx); }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        if (b.y - b.r < CEILING_Y) { b.y = CEILING_Y + b.r; b.vy = Math.abs(b.vy) * 0.55; }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        if (b.y + b.r >= GROUND_Y) { b.y = GROUND_Y - b.r; b.vy = spec.bounceVy; b.scaleX = 1.22; b.scaleY = 0.8; }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        for (const bl of this.blocks) this.resolveBubbleBlockCollision(b, bl);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      return;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const currentTheme = LEVELS[this.levelIndex].theme;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    updateAmbientWeather(dt, this.bgTime, currentTheme);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (this.state === \'MAP_TRAVEL\') {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      this.travel.progress += dt / this.travel.duration;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      for (let i = this.travel.exhaust.length - 1; i >= 0; i--) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const ex = this.travel.exhaust[i];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        ex.x += ex.vx * dt;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        ex.y += ex.vy * dt;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        ex.life -= dt;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        if (ex.life <= 0) this.travel.exhaust.splice(i, 1);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (this.travel.progress >= 1) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        this.finishMapTravel();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      return;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (this.state !== \'PLAYING\') {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      this.updateScarfPhysics(dt);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      this.updateEffects(dt);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      return;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // Tactile hitstop freeze frame on heavy impacts"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (this.hitstopTimer > 0) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      this.hitstopTimer = Math.max(0, this.hitstopTimer - dt);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (this.shakeTimer > 0) this.shakeTimer = Math.max(0, this.shakeTimer - dt);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      return;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const lvl = LEVELS[this.levelIndex];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const gravity = BASE_GRAVITY * (lvl.gravityScale || 1.0);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (this.stageIntroTimer > 0) this.stageIntroTimer = Math.max(0, this.stageIntroTimer - dt);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (this.shakeTimer > 0) this.shakeTimer = Math.max(0, this.shakeTimer - dt);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (this.flashAlpha > 0) this.flashAlpha = Math.max(0, this.flashAlpha - dt * 2.2);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (this.comboTimer > 0) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      this.comboTimer = Math.max(0, this.comboTimer - dt);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (this.comboTimer === 0) this.comboCount = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // 1. Timer"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (this.freezeTimer > 0) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      this.freezeTimer = Math.max(0, this.freezeTimer - dt);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    } else {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      this.timeRemaining -= dt;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (this.timeRemaining <= 0) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        this.timeRemaining = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        this.damagePlayer(\'O tempo da fase acabou!\');"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        return;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // 2. Player movement & animations"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const pl = this.player;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    let moveDir = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (this.input.left) moveDir -= 1;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (this.input.right) moveDir += 1;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (moveDir !== 0 && moveDir !== pl.prevMoveDir) {"
