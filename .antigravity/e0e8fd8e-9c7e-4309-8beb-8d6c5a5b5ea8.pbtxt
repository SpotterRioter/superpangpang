            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      } else if (track.arpMode === \'offbeat\' && sub === 2) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        chord.forEach((n) => {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
