            }
            lines {
              text: "    if (bassNote && NOTE_FREQ[bassNote]) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      this.playBassNote(track.instrument, NOTE_FREQ[bassNote], time, stepSec * 1.55);"
