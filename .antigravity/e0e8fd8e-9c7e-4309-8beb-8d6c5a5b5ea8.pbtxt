            }
            lines {
              text: "    ctx.fill();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ctx.stroke();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // Orbiting highlight arc"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ctx.strokeStyle = \'rgba(255,255,255,0.75)\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ctx.lineWidth = 2;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ctx.beginPath();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ctx.arc(0, -pl.h * 0.52 - celebrateHop, 30 * pulse, bgTime * 3, bgTime * 3 + 0.9);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ctx.stroke();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ctx.restore();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
