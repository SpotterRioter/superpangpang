              text: "    ctx.fillRect(0, 0, WORLD_W, WORLD_H);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // Subtle vintage cartographic grid"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
