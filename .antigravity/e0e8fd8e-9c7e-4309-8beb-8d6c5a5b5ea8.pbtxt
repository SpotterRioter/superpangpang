            }
            lines {
              text: "    ctx.strokeStyle = isGolden ? \'rgba(251, 191, 36, 0.3)\' : \'rgba(34, 211, 238, 0.28)\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
