            }
            lines {
              text: "          const bl = this.blocks[bi];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          if (h.x >= bl.x - 4 && h.x <= bl.x + bl.w + 4 && h.topY <= bl.y + bl.h && h.bottomY >= bl.y) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            h.topY = bl.y + bl.h;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            hitBlock = true;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            if (bl.destructible) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              this.blocks.splice(bi, 1);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              this.audio.blockBreak();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              this.spawnBlockShards(bl);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              this.spawnParticles(bl.x + bl.w / 2, bl.y + bl.h / 2, \'#fde047\', 10, 0.9);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              this.addScore(150, bl.x + bl.w / 2, bl.y, \'+150\', \'#fde047\');"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              this.maybeSpawnPowerup(bl.x + bl.w / 2, bl.y + bl.h / 2, 0.28);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              this.harpoons.splice(i, 1);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            } else if (h.sticky) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              h.latched = true;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              this.spawnParticles(h.x, h.topY, \'#fde047\', 8, 0.65);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              this.audio.hookLatch();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            } else {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              this.harpoons.splice(i, 1);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            break;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
