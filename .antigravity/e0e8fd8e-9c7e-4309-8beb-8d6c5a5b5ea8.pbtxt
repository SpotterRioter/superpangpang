              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // Drifting map clouds"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ctx.fillStyle = \'rgba(255,255,255,0.08)\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    for (let c = 0; c < 6; c++) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const mx = ((bgTime * (12 + c * 3) + c * 180) % (WORLD_W + 180)) - 90;"
