            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "export function updateAmbientWeather(dt: number, bgTime: number, theme: ThemeId): void {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (theme === \'moscow\' || theme === \'alps\') {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    for (const f of SNOW_FLAKES) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      f.y += f.speed * f.depth * dt;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      f.x += Math.sin(bgTime * 1.9 + f.drift) * (theme === \'moscow\' ? 34 : 18) * f.depth * dt;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (f.y > GROUND_Y) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        f.y = -4;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        f.x = Math.random() * WORLD_W;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (f.x < 0) f.x = WORLD_W;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (f.x > WORLD_W) f.x = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
