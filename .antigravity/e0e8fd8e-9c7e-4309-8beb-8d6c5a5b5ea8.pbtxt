              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // Ground contact shadow"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const shScale = Math.max(0.62, 1 - celebrateHop / 35);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  ctx.fillStyle = \'rgba(0, 0, 0, 0.42)\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  ctx.beginPath();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  ctx.ellipse(0, -1, 20 * shScale, 5.2 * shScale, 0, 0, Math.PI * 2);"
