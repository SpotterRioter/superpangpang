ort interface Bubble {\n  x: number;\n  y: number;\n  size: 0 | 1 | 2 | 3;\n  r: number;\n  vx: number;\n  vy: number;\n  scaleX: number;\n  scaleY: number;\n  rotAngle: number;\n  wobble: number;\n  flashTimer: number;\n}\n\nexport interface Harpoon {\n  x: number;\n  topY: number;\n  bottomY: number;\n  speed: number;\n  sticky: boolean;\n  latched: boolean;\n  latchTimer: number;\n  waveOffset: number;\n  sparksTimer: number;\n}\n\nexport interface Block {\n  x: number;\n  y: number;\n  w: number;\n  h: number;\n  destructible: boolean;\n}\n\nexport interface PowerupItem {\n  x: number;\n  y: number;\n  vy: number;\n  r: number;\n  type: PowerupType;\n  life: number;\n  spin: number;\n}\n\nexport interface Particle {\n  x: number;\n  y: number;\n  vx: number;\n  vy: number;\n  r: number;\n  color: string;\n  life: number;\n  maxLife: number;\n  gravity?: number;\n  glow?: boolean;\n}\n\nexport interface Shard {\n  x: number;\n  y: number;\n  vx: number;\n  vy: number;\n  w: number;\n  h: number;\n  rot: number;\n  vrot: number;\n  color: string;\n  border: string;\n  life: number;\n  maxLife: number;\n}\n\nexport interface ShockRing {\n  x: number;\n  y: number;\n  r: number;\n  maxR: number;\n  color: string;\n  life: number;\n  maxLife: number;\n}\n\nexport interface ScorePopup {\n  x: number;\n  y: number;\n  text: string;\n  color: string;\n  scale?: number;\n  life: number;\n  maxLife: number;\n}\n\nexport interface TravelState {\n  fromIndex: number;\n  toIndex: number;\n  progress: number;\n  duration: number;\n  isSpace: boolean;\n  exhaust: Particle[];\n}\n\nexport interface HudSnapshot {\n  state: GameState;\n  score: number;\n  highScore: number;\n  newRecordReached: boolean;\n  levelIndex: number;\n  levelId: number;\n  totalLevels: number;\n  stageName: string;\n  stageCountry: string;\n  stageFlag: string;\n  isSpace: boolean;\n  ostTitle: string;\n  lives: number;\n  timeRemaining: number;\n  timeLimit: number;\n  doubleTimer: number;\n  stickyTimer: number;\n  hasShield: boolean;\n  freezeTimer: number;\n  comboCount: number;\n  stageTimeBonus: number;\n  victoryLivesBonus: number;\n  gameOverReason: string;\n  musicEnabled: boolean;\n  sfxMuted: boolean;\n}\n"
