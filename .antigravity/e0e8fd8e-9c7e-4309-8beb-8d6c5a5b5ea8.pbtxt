            }
            lines {
              text: "    if (isGolden) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const clawSpread = h.latched ? 12 : 6.5 + Math.sin(bgTime * 18) * 2;"
