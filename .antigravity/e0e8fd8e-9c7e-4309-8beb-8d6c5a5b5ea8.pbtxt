      arguments_json: "{\"CodeContent\":\"<!doctype html>\\n<html lang=\\\"pt-BR\\\">\\n  <head>\\n    <meta charset=\\\"UTF-8\\\" />\\n    <meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\\\" />\\n    <title>Super Pang World Tour</title>\\n    <meta name=\\\"description\\\" content=\\\"Jogo arcade cl\303\241ssico remasterizado com 24 destinos mundiais e espaciais, cen\303\241rios ilustrados em camadas, sprites animados e trilha sonora original (OST) regional.\\\" />\\n    <meta property=\\\"og:title\\\" content=\\\"Super Pang World Tour\\\" />\\n    <meta property=\\\"og:description\\\" content=\\\"Viaje por 24 destinos da Terra at\303\251 a Lua e Marte estourando bolhas com trilha sonora original e gr\303\241ficos arcade remasterizados.\\\" />\\n    <meta property=\\\"og:type\\\" content=\\\"website\\\" />\\n    <meta name=\\\"twitter:card\\\" content=\\\"summary_large_image\\\" />\\n    <link rel=\\\"preconnect\\\" href=\\\"https://fonts.googleapis.com\\\" />\\n    <link rel=\\\"preconnect\\\" href=\\\"https://fonts.gstatic.com\\\" crossorigin />\\n    <link href=\\\"https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@500;600;700&family=Press+Start+2P&display=swap\\\" rel=\\\"stylesheet\\\" />\\n  </head>\\n  <body class=\\\"bg-[#060913] text-slate-100 antialiased overflow-hidden select-none\\\">\\n    <div id=\\\"root\\\"></div>\\n    <script type=\\\"module\\\" src=\\\"/src/main.tsx\\\"></script>\\n  </body>\\n</html>\\n\",\"Description\":\"Configure HTML title, metadata, and arcade typography fonts\",\"Overwrite\":true,\"TargetFile\":\"/index.html\",\"toolAction\":\"Updating index.html\",\"toolSummary\":\"Update index.html\"}"
